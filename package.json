{
	"name": "murc-rates",
	"version": "0.0.0-semantic-release",
	"description": "Unofficial TypeScript client and CLI for exchange rates published by MURC",
	"keywords": [
		"mufg",
		"murc",
		"exchange-rate",
		"jpy",
		"tts",
		"ttb",
		"ttm",
		"forex"
	],
	"license": "MIT",
	"repository": "privatenumber/mufg-rates",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist",
		"skills"
	],
	"type": "module",
	"bin": "./dist/cli/index.mjs",
	"exports": {
		"types": "./dist/api/index.d.mts",
		"default": "./dist/api/index.mjs"
	},
	"packageManager": "pnpm@10.20.0",
	"scripts": {
		"cli": "node src/cli/index.ts",
		"build": "pkgroll --clean-dist",
		"check:raw-data": "node scripts/check-raw-data.mjs",
		"lint": "lintroll --cache --git",
		"test": "pnpm check:raw-data && node tests/index.ts",
		"test:live": "MUFG_LIVE=1 node tests/index.ts",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json",
		"prepare": "skills-npm"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"dependencies": {
		"ansis": "^4.4.0",
		"cleye": "3.0.0-beta.2",
		"linkedom": "^0.18.13",
		"officecrypto-tool": "^0.0.19",
		"string-width": "^8.3.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"clean-pkg-json": "^2.0.0",
		"lintroll": "^1.32.1",
		"manten": "^2.0.2",
		"nano-spawn": "^2.1.0",
		"pkgroll": "^2.28.1",
		"skills-npm": "^1.2.1",
		"typescript": "^6.0.3"
	}
}
